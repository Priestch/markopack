  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@netlify/edge-functions": "^2.11.1",
    "@netlify/functions": "^3.0.4"
  },
  "peerDependencies": {
    "@marko/run": "^0.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
