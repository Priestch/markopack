{
  "name": "@markopack/adapter-netlify",
  "version": "0.1.4",
  "description": "Netlify adapter for markopack",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Priestch/markopack.git"
