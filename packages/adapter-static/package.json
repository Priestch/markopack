{
  "name": "@markopack/adapter-static",
  "version": "0.1.0",
  "description": "Static adapter for markopack",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Priestch/markopack.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/default-entry.mjs dist/default-entry.mjs"
  },
  "dependencies": {
    "@markopack/core": "file:../core",
    "compression": "^1.8.0",
    "htmlparser2": "^10.0.0",
    "sirv": "^1.0.15",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5"
  },
  "peerDependencies": {
    "@marko/run": "^0.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
