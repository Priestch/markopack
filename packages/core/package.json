{
  "name": "@markopack/core",
  "version": "0.2.0",
  "type": "module",
  "description": "Shared core utilities for markopack adapters",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Priestch/markopack.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter/middleware": {
      "types": "./dist/adapter/middleware.d.ts",
      "import": "./dist/adapter/middleware.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen/index.js"
    },
    "./routes/builder": {
      "types": "./dist/routes/builder.d.ts",
      "import": "./dist/routes/builder.js"
    },
    "./routes/walk": {
      "types": "./dist/routes/walk.d.ts",
      "import": "./dist/routes/walk.js"
    },
    "./utils/fs": {
      "types": "./dist/utils/fs.d.ts",
      "import": "./dist/utils/fs.js"
    },
    "./utils/route": {
      "types": "./dist/utils/route.d.ts",
      "import": "./dist/utils/route.js"
    },
    "./utils/server": {
      "types": "./dist/utils/server.d.ts",
      "import": "./dist/utils/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@marko/run": "^0.11.13",
    "@types/node": "^24.0.13"
  },
  "peerDependencies": {
    "@marko/run": "^0.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
