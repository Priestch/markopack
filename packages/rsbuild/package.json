{
  "name": "@rs-marko-run/rsbuild",
  "version": "0.1.0",
  "description": "Rsbuild integration for @marko/run using shared rs-marko-run core",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marko-js/run.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@rs-marko-run/core": "file:../core"
  },
  "peerDependencies": {
    "@marko/run": "^0.9.0",
    "@rsbuild/core": "^2.0.2",
    "marko": "5 - 6",
    "rsbuild-plugin-marko": "*"
  },
  "devDependencies": {
    "@marko/run": "^0.9.6",
    "@rsbuild/core": "^2.0.2",
    "@types/node": "^24.0.13",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
