{
  "name": "@markopack/rspack",
  "version": "0.1.1",
  "description": "Direct rspack integration for @marko/run — zero framework overhead",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Priestch/markopack.git"
  },
  "keywords": ["marko", "rspack", "ssr", "framework"],
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@markopack/core": "^0.1.1",
    "@markopack/compiler": "^0.1.1",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@marko/run": "^0.9.0",
    "@rspack/core": "^2.0.1",
    "marko": "5 - 6"
  },
  "devDependencies": {
    "@marko/run": "^0.9.6",
    "@rspack/core": "^2.0.1",
    "@types/node": "^24.0.13",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
